#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
compiled="$root/dist-server/server/services/isolation/managed-claude-launcher.js"

# Production runs the compiled launcher only. An incomplete server build must
# fail closed instead of silently running TypeScript source that differs from
# dist-server (T-1381).
if [[ "${NODE_ENV:-development}" == "production" ]]; then
  if [[ -f "$compiled" ]]; then
    exec node "$compiled" "$@"
  fi
  echo "nassaj: compiled Claude launcher is missing" \
    "(dist-server/server/services/isolation/managed-claude-launcher.js);" \
    "refusing to run TypeScript source in production. Rebuild the server." >&2
  exit 1
fi

# Development always executes source so an old dist-server tree cannot shadow
# the current launcher.
exec "$root/node_modules/.bin/tsx" \
  --tsconfig "$root/server/tsconfig.json" \
  "$root/server/services/isolation/managed-claude-launcher.ts" "$@"
