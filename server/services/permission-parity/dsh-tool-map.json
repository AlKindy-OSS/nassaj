   "cls": "fetch",
   "fields": {
    "url": "string"
   },
   "required": [
    "url"
   ],
   "ignored": []
  },
  "web_search": {
   "claude": "WebSearch",
   "cls": "tool",
   "fields": {
    "queries": "array"
   },
   "required": [
    "queries"
   ],
   "ignored": []
  },
  "write": {
   "claude": "Write",
   "cls": "edit",
   "fields": {
    "file_path": "string",
    "content": "string"
   },
   "required": [
    "content",
    "file_path"
   ],
   "ignored": [
    "sandbox_permissions",
    "justification"
   ]
  }
 }
