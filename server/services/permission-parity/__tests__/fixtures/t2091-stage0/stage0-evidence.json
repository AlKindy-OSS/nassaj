{
 "provenance": {
  "task": "T-2091 S0",
  "package": "@deepseek-ai/dsh@0.2.2-rc.1",
  "recordedAt": "2026-11-08",
  "layer": "server/governance/dsh-nassaj-layer.yml without the nassaj-policy insert, LLM row pointed at the stage0 fake LLM, plus t2091-probe, t2091-hostile and two engines.dsh packages",
  "runner": "run.mjs"
 },
 "findings": {
  "P1_public_api": "ctx.tools.guard/execute/restrict/definitions/get/executable/schemas/register are all functions",
  "P2_probe": "ctx.tools.execute({calls:[{type:\"tool-call\",id,name:\"__nassaj_probe__\",arguments:\"{}\"}],signal}) at appReady: our pre-execute sees the call (agent null); guard without permit -> isError \"t2091: no permit\"; with permit -> UNKNOWN_TOOL (ToolNotFoundError)",
  "guard_after_skipping_listener": "a prepend global pre-execute listener returning {kind:allow} without next(): our listener never runs (no pre event) and the guard still denies",
  "guard_subagent_scope": "a subagent bash call without permit is denied by the global guard (agent id = subagent id); with permit it runs",
  "restrict": "ctx.tools.restrict from the plugin global ctx THROWS (requires a scoped agent ctx); payload.agent.ctx.tools.restrict inside agent/pre-step works, but the FIRST model request of that agent still lists the tool (restriction applies from the next step); a later call of the restricted tool fails UNKNOWN_TOOL",
  "engines_dsh": "ENFORCED for a --patch row loaded by relative file path: the nearest package.json engines.dsh is checked; >=99.0.0 -> row disabled with a stderr warning (dsh boots on); \">=0.2.2-rc.1 <1.0.0\" matches 0.2.2-rc.1 (prerelease in range). Bare package names resolve from the PROFILE dir, not the layer. An exemption exists (dsh plugin allow-version)",
  "plugin_row_failure_non_fatal": "a plugin row that fails to import or is engines-disabled is skipped and dsh boots without it",
  "unknown_layer_id": "a layer row whose id does not exist (disabled or config) is ignored silently; boot and turn succeed",
  "fake_llm_test_layer": "replacing only the llm-deepseek row baseURL routes every request to the local fake LLM (all runs)",
  "PTC_subcalls": "NOT measured: PTC stays disabled by the Nassaj layer (ptc-runtime, tool-executor-ptc)",
  "synthetic_subagent_probe": "NOT possible at boot via the public API (no Agent object exists before a session); subagent coverage measured with a real subagent",
  "engines_prerelease_semantics": "T-2091 S2 live: dsh compares engines.dsh with prereleases INCLUDED: 0.2.2-rc.1 satisfies \">=0.2.1 <1.0.0\" (plugin loaded) while \">=0.3.0 <1.0.0\" disables the row (incompatible)",
  "dump_config": "dsh nassaj-acp --from-default-profile acp --patch <layer> --dump-config prints the composed rows (top-level - id:, 2-space keys, 4-space config scalars; inserted rows dedented); 100 rows under the T-2091 layer, every Nassaj security row in its expected state",
  "reduced_layer_new_tools": "with the T-2091 layer (no tool-disable rows) dsh 0.2.2-rc.1 additionally registers exit_plan_mode, interrupt_agent, list_agents, send_message and working_directory (hidden and denied: outside dsh-tool-map.json); workflow-ptc, tool-workflow and tool-goal stay pending (ptc-runtime and goal disabled)"
 },
