    "dompurify": "^3.4.12",
    "express": "^4.18.2",
    "focus-trap-react": "^12.0.3",
    "gray-matter": "^4.0.3",
    "i18next": "^25.7.4",
    "i18next-browser-languagedetector": "^8.2.0",
    "jsdom": "^25.0.1",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.1",
    "katex": "^0.16.25",
    "lucide-react": "^0.515.0",
    "mermaid": "^11.15.0",
    "mime-types": "^3.0.1",
    "multer": "^2.3.0",
    "node-pty": "^1.2.0-beta.12",
    "postcss": "^8.4.32",
    "postcss-value-parser": "4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.2.3",
    "react-easy-crop": "6.2.3",
    "react-error-boundary": "^4.1.2",
    "react-i18next": "^16.5.3",
    "react-markdown": "^10.1.0",
