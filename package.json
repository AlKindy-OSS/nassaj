{
  "name": "nassaj",
  "version": "2.3.0.0",
  "description": "Nassaj — multi-provider AI coding workspace with RTL Arabic support",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22 <25"
  },
  "main": "dist-server/server/index.js",
  "bin": {
    "cloudcli": "dist-server/server/cli.js"
  },
  "files": [
    "server/",
    "shared/",
    "public/api-docs.html",
    "public/modelConstants.js",
    "dist/",
    "dist-server/",
    "scripts/",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlKindy-OSS/nassaj.git"
  },
  "bugs": {
    "url": "https://github.com/AlKindy-OSS/nassaj/issues"
  },
  "homepage": "https://github.com/AlKindy-OSS/nassaj#readme",
  "scripts": {
    "dev": "concurrently --kill-others \"npm run server:dev\" \"npm run client\"",
    "server": "node dist-server/server/bootstrap.js",
    "server:dev": "tsx --tsconfig server/tsconfig.json server/index.js",
    "server:dev-watch": "tsx watch --tsconfig server/tsconfig.json server/index.js",
    "test": "npm run test:server; s=$?; npm run test:src; c=$?; npm run test:scripts; k=$?; if [ $s -ne 0 ] || [ $c -ne 0 ] || [ $k -ne 0 ]; then exit 1; fi",
    "test:scripts": "bash scripts/run-without-core.sh bash -c 'scratch=$(mktemp -d \"$PWD/.test-scripts-scratch.XXXXXX\") || exit 1; trap '\"'\"'node scripts/cleanup-test-scratch.mjs \"$scratch\"'\"'\"' EXIT; export TMPDIR=\"$scratch\" NASSAJ_TEST_TMP=\"$scratch\"; test -f scripts/server-build-atomic.test.mjs || exit 1; mapfile -d \"\" -t script_tests < <(find scripts -type f -name \"*.test.mjs\" -print0 | LC_ALL=C sort -z); test_files=(\"${script_tests[@]}\" shared/release-version-policy.test.js); status=0; for test_file in \"${test_files[@]}\"; do printf \"## test:scripts:%s\\n\" \"$test_file\"; node \"$test_file\" || status=1; done; node scripts/check-crash-artifacts.mjs || status=1; exit $status'",
    "test:server": "bash scripts/run-without-core.sh node scripts/run-isolated-node-tests.mjs server",
    "pretest:server": "node scripts/permission-launch-inventory.mjs --check && node scripts/permission-launch-inventory.mjs --mutation-test",
    "permission:inventory:check": "node scripts/permission-launch-inventory.mjs --check && node scripts/permission-launch-inventory.mjs --mutation-test",
    "test:src": "bash scripts/run-without-core.sh node scripts/run-isolated-node-tests.mjs src",
    "test:release-server": "bash scripts/run-without-core.sh node scripts/run-isolated-node-tests.mjs server server/cli.update-policy.test.js server/index.security.test.js server/middleware/global-body-limits.test.ts server/modules/database/migrations.backup.test.ts server/modules/database/pending-server-actions.migration.test.ts server/modules/database/repositories/api-keys.security.test.ts server/modules/database/repositories/credentials.encryption.test.ts server/modules/database/repositories/pending-server-actions.integration.test.ts server/modules/projects/tests/project-clone.service.test.ts server/modules/providers/list/claude/__tests__/claude-transcript-fork.test.ts server/modules/providers/services/__tests__/session-fork.service.test.ts server/modules/providers/services/company-credentials.service.test.ts server/modules/providers/services/provider-governance.service.test.ts server/routes/agent.git-transport.test.ts server/routes/git.guards.test.ts server/routes/tests/commands-file-fd.test.ts server/services/agent-sse-ticket.service.test.ts server/services/isolation/provider-secrets-key-manager.test.ts server/services/oidc-verifier.service.test.ts server/services/source-updater.test.js server/shared/utils.bounded-root.test.ts",
    "test:client": "bash scripts/run-without-core.sh env NODE_ENV=test vitest run --configLoader runner --maxWorkers=2",
    "test:client:conversation-closed": "npm run test:client -- src/components/chat/hooks/useConversationClosed.test.tsx src/components/main-content/view/subcomponents/MainContentTitle.workflowStatus.test.tsx src/components/participants/SessionParticipantsBar.closedHeader.integration.test.tsx",
    "test:smoke:btw-hook": "d=$(mktemp -d); trap 'rm -rf \"$d\"' EXIT; DATABASE_PATH=\"${DATABASE_PATH:-$d/auth.db}\" tsx --tsconfig server/tsconfig.json scripts/smoke/btw-hook-precedence.smoke.mjs",
    "test:smoke:btw-fork": "d=$(mktemp -d); trap 'rm -rf \"$d\"' EXIT; DATABASE_PATH=\"${DATABASE_PATH:-$d/auth.db}\" tsx --tsconfig server/tsconfig.json scripts/smoke/btw-fork-resume.smoke.mjs",
    "doctor": "node scripts/doctor.mjs",
    "connectors:doctor": "tsx --tsconfig server/tsconfig.json scripts/connectors-doctor.mjs",
    "connectors:setup": "node scripts/connectors-setup.mjs",
    "connectors:trust": "node scripts/connectors-trust.mjs",
    "connectors:profile": "node scripts/connectors-profile.mjs",
    "audit:ui-controls": "node scripts/audit-ui-controls.mjs --worktree",
    "client": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "node scripts/client-build-atomic.mjs",
    "publish:client:isolated": "node scripts/client-isolated-publish.mjs",
    "test:client:isolated-publish": "node scripts/client-isolated-publish.test.mjs",
    "build:client:watch": "node scripts/client-build-watch.mjs",
    "typecheck:client:preview": "tsc --noEmit -p tsconfig.preview.json",
    "build:server": "node scripts/server-build-atomic.mjs",
    "build:update-candidate": "node scripts/source-update-candidate.mjs",
    "build:server:watch": "node scripts/server-build-watch.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p server/tsconfig.json",
    "lint": "eslint src/ server/ shared/ scripts/ commitlint.config.js postcss.config.js tailwind.config.js vite.config.js eslint.config.js ecosystem.config.example.cjs --report-unused-disable-directives-severity=warn --max-warnings=460",
    "lint:fix": "eslint src/ server/ shared/ scripts/ commitlint.config.js postcss.config.js tailwind.config.js vite.config.js eslint.config.js ecosystem.config.example.cjs --fix",
    "start": "npm run build && npm run server",
    "release": "./release.sh",
    "prepublishOnly": "npm run build",
    "postinstall": "node scripts/fix-node-pty.js && node scripts/patch-codex-sdk-image-only.mjs --apply",
    "prepare": "husky",
    "update:platform": "./update-platform.sh",
    "prebuild:client": "node scripts/ensure-wiki-index.mjs",
    "pretest:client": "node scripts/ensure-wiki-index.mjs",
    "pretypecheck": "node scripts/ensure-wiki-index.mjs"
  },
  "keywords": [
    "claude code",
    "claude-code",
    "claude-code-ui",
    "cloudcli",
    "codex",
    "gemini",
    "gemini-cli",
    "cursor",
    "cursor-cli",
    "anthropic",
    "openai",
    "google",
    "coding-agent",
    "web-ui",
    "ui",
    "mobile IDE"
  ],
  "author": "Nassaj Contributors",
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.152",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.3.3",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/merge": "^6.11.1",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@fontsource-variable/noto-sans-arabic": "^5.3.0",
    "@fontsource-variable/readex-pro": "^5.3.0",
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
