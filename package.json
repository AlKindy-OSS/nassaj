    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "node-gyp": "^10.0.0",
    "playwright": "^1.62.1",
    "pm2": "7.0.1",
    "sharp": "^0.35.4",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "@babel/core": "^7.29.6",
    "brace-expansion@^1.0.0": "^1.1.18",
    "brace-expansion@^5.0.0": "^5.0.9",
    "js-yaml@^4.0.0": "^4.3.2",
    "shell-quote": "^1.9.0",
    "undici": "^6.24.0",
    "prismjs": "^1.30.0",
    "tar": "^7.5.21",
    "pm2@7.0.1": {
      "ws@8.20.0": "8.21.0"
    },
    "js-yaml@^3.0.0": "^3.15.2"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,js,jsx}": "eslint",
    "server/**/*.{js,ts}": "eslint"
  },
