[Unit]
Description=Nassaj first release-runtime cutover recovery
DefaultDependencies=no
After=local-fs.target nassaj-cutover-gate-restore.service cloudflared.service
Requires=nassaj-cutover-gate-restore.service
Wants=cloudflared.service
Before=pm2-nassaj.service pm2-nassaj-dev.service

[Service]
Type=oneshot
User=root
Group=root
Environment=HOME=/root
Environment=PATH=/usr/bin:/bin
ExecStart=/usr/bin/node /usr/local/lib/nassaj-release-operator/scripts/release-runtime-cutover-recovery.mjs
TimeoutStartSec=15min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/nassaj-release-operator

[Install]
WantedBy=multi-user.target
