[Unit]
Description=Nassaj fixed loopback maintenance responder
Documentation=https://github.com/AlKindy-OSS/nassaj
DefaultDependencies=no
After=local-fs.target
Before=nassaj-cutover-gate-restore.service

[Service]
Type=simple
DynamicUser=yes
ExecStart=/usr/bin/node /usr/local/lib/nassaj-release-operator/scripts/nassaj-maintenance-responder.mjs
Restart=on-failure
RestartSec=1s
TimeoutStartSec=10s
TimeoutStopSec=10s
UMask=0077
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
PrivateUsers=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
RemoveIPC=yes
RestrictAddressFamilies=AF_INET
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
