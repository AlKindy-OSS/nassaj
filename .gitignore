# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build outputs
dist/
dist-server/
dist-ssr/
build/
out/
# Deploy rollback backups
*.rollback-bak/
dist-server.bak-*/

# Environment variables
.env
# Timestamped hand-made backups of .env (`.env.bak-<what>-<ts>`) are real
# secret files that were NOT covered by the patterns below — one sat stageable
# in the repo root for two days. They stay on disk (they are recovery copies);
# they must never be committable.
.env.bak*
.env.*.bak
.env.local
.env.development.local
.env.test.local
.env.production.local

# Per-node PM2 ecosystem files (host-specific, generated by bootstrap-node.sh with
# inline secrets/port/DB path). The runnable node file `ecosystem.<node>.config.cjs`
# and any local `ecosystem.config.cjs` must NOT be tracked — tracking them would leak
# host secrets and can reintroduce a prior host outage. Only the host-neutral reference
# template `ecosystem.config.example.cjs` stays tracked (negated below).
ecosystem.config.cjs
ecosystem.*.config.cjs
!ecosystem.config.example.cjs

# Node customization directory (ADR-156 د.1), owned by the operator and never
# tracked: `node.env` (NASSAJ_RELEASE_SOURCE, TMPDIR, node flags),
# `release-source.lock.json` (the TOFU pin of the release-source identity), and
# later `node-overlay.json` + `overlay/`. Listed before any writer exists: a
# writer that lands first turns every update into a fresh `dirty_worktree`
# (B-1050). Anchored to the repository root so a nested `config/` elsewhere in
# the tree keeps its normal tracking.
/config/

# Temporary visual-gate harness files (T-1730) — not committed
vite.t1730-gate.config.js
vitest.t1730.config.ts
t1730-harness.html
src/t1730-harness-entry.tsx

