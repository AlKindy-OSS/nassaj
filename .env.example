# CloudCLI UI Environment Configuration
# Only includes variables that are actually used in the code
#
# TIP: Run 'cloudcli status' to see where this file should be located
#      and to view your current configuration.
#
# Available CLI commands:
#   claude-code-ui    - Start the server (default)
#   cloudcli start    - Start the server
#   cloudcli status   - Show configuration and data locations
#   cloudcli help     - Show help information
#   cloudcli version  - Show version information

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Backend server port (Express API + WebSocket server)
#API server
SERVER_PORT=3001
#Frontend port
VITE_PORT=5173

# Host/IP to bind servers to (default: 0.0.0.0 for all interfaces)
# Use 127.0.0.1 to restrict to localhost only
HOST=0.0.0.0

# CORS allowed origins — comma-separated list of full origins (scheme + host + optional port).
# If unset, the server allows localhost:3004, localhost:3001, localhost:5173 only.
# Every public origin this instance is served on (a tunnel or reverse-proxy
# hostname) MUST be listed here — deployment hostnames are never hardcoded.
# Requests with no Origin header (curl, server-to-server) are always allowed.
# Changes take effect after server restart.
# ALLOWED_ORIGINS=https://nassaj.example.com,http://localhost:3004

# Uncomment the following line if you have a custom claude cli path other than the default "claude"
# CLAUDE_CLI_PATH=claude

# -----------------------------------------------------------------------------
# UPGRADE NOTE — Claude base-URL guard (fail-closed)
# -----------------------------------------------------------------------------
# Every Claude spawn is gated by a fail-closed guard that rejects any *_BASE_URL
# (env or settings.json) whose host is not the official Anthropic API, an engaged
# per-user engine provider, or an explicit operator escape hatch. The default
# install sets no base URL, so this is invisible. BUT if you (or your shell/PM2
# env) set ANTHROPIC_BASE_URL to a company proxy / LiteLLM / gateway, the guard
# will refuse to spawn unless you allow that host below. Pick ONE:
#
#   * Proxy / gateway (most common): list its hostname(s), comma/space-separated.
# NASSAJ_ALLOWED_ANTHROPIC_HOSTS=proxy.internal.example, gateway.corp.example
#
#   * Amazon Bedrock routing (Claude Code reads regional AWS hosts):
# CLAUDE_CODE_USE_BEDROCK=1
#
#   * Google Vertex routing (Claude Code reads regional GCP hosts):
# CLAUDE_CODE_USE_VERTEX=1

# =============================================================================
# VENDOR-RESILIENCE GUARD (Claude/Anthropic subprocess)
# =============================================================================
# Iron rule (enforced in code, fail-closed): the Claude Code / Anthropic path
# must NEVER be pointed at a non-Anthropic / competitor endpoint. Before the
# Claude subprocess is spawned, server/services/isolation/anthropic-base-url-guard.js
# validates ANTHROPIC_BASE_URL (and its SDK-honored siblings
# ANTHROPIC_BEDROCK_BASE_URL / ANTHROPIC_VERTEX_BASE_URL): if any is SET to a host
# that is not approved, the server REFUSES to spawn. Any UNKNOWN endpoint-routing
# override (a *_BASE_URL under the ANTHROPIC_/CLAUDE_ namespace) is also refused.
# If these are UNSET (the nassaj-dev default), the guard is a no-op and the
# standard Anthropic path is used. The same allowlist is applied to the per-user
# settings.json `env` block inside each CLAUDE_CONFIG_DIR (which the CLI honors
# downstream of the spawn env) — a competitor base URL there cannot bypass it.
#
# Approved hosts: official Anthropic (api.anthropic.com / *.anthropic.com),
# official Bedrock (*.amazonaws.com when CLAUDE_CODE_USE_BEDROCK is enabled) and
# Vertex (*.googleapis.com when CLAUDE_CODE_USE_VERTEX is enabled), PLUS any host
# listed below.
#
# Escape hatch — ONLY for a legitimate Anthropic-backed proxy / credit-pool
# gateway / multi-user routing layer. Comma-separated list of hosts (or full
# URLs; reduced to host). A parent-domain entry also covers its subdomains.
# Do NOT add a competitor endpoint here, and do NOT remove the guard.
# NASSAJ_ALLOWED_ANTHROPIC_HOSTS=claude-gateway.corp.example.com

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Path to the authentication database file
# This is where user credentials, API keys, and tokens are stored.
#
# To use a custom location:
# DATABASE_PATH=/path/to/your/custom/auth.db
#
# Claude Code context window size (maximum tokens per session)
# CONTEXT_WINDOW=  # اتركه فارغاً/معلّقاً ليُستنتَج من الموديل (opus / sonnet 4.6+ = 1M). اضبط رقماً فقط لفرض override.

# =============================================================================
# AUTH (Phase-MU multi-user)
# =============================================================================
# JWT signing secret used to sign/verify stateless tokens. Must be >= 32 chars.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Keep the real .env file chmod 600. If unset, a per-install secret is generated
# and stored in app_config (works out of the box, but env is preferred).
# JWT_SECRET=
#
# Bootstrap owner — created automatically on first run if no owner exists.
# Defaults username to "owner". If BOOTSTRAP_OWNER_PASSWORD is unset, a strong
# random password is generated and printed ONCE to the server log.
# BOOTSTRAP_OWNER_USERNAME=owner
# BOOTSTRAP_OWNER_PASSWORD=
#
# Passkeys (WebAuthn) — relying party identity. Required in production for
# passkey login to work on the deployed domain; without them the server falls
# back to a localhost-only dev config (rpID=localhost, origin=http://localhost:5173).
# WEBAUTHN_RP_ID: registrable domain only (no scheme, no port).
# WEBAUTHN_ORIGIN: full origin(s) incl. scheme; comma-separated list supported.
# WEBAUTHN_RP_NAME: human-readable app name shown in browser passkey prompts.
# WEBAUTHN_RP_ID=example.com
# WEBAUTHN_ORIGIN=https://example.com
# WEBAUTHN_RP_NAME=Nassaj

# =============================================================================
# OIDC SSO (P-IDP-3, ADR-046)
# =============================================================================
# OIDC Relying Party flow against your team IdP. Every browser/IdP route
# self-gates on OIDC_ENABLED and returns 501 unless it is exactly 'true'.
# OIDC SSO (P-IDP-3, ADR-046) — set OIDC_ENABLED=true once your IdP is reachable
OIDC_ENABLED=false
OIDC_ISSUER_URL=https://id.example.com
OIDC_CLIENT_ID=nassaj-app
# OIDC_REDIRECT_URI=https://nassaj.example.com/api/auth/oidc/callback

# =============================================================================
# CLAUDE GHOST-SESSION DETACH (ADR-042 / B-80c)
# =============================================================================
# Detaches a claude session from the SHUTDOWN DRAIN count once it has lost every
# listener (primary socket closed AND zero live read-only mirrors) for longer
# than the grace period. It does NOT abort the run: the SDK child finishes its
# turn and writes complete jsonl — only the drain stops waiting for it, so a
# `pm2 restart` after every tab is closed no longer hangs until kill_timeout.
# OFF by default (any other value/unset = disabled); when OFF the drain counts
# every active session exactly as before. Accepts 1/true/yes/on.
# CLAUDE_GHOST_DETACH=
#
# Grace period (ms) a session must have NO listener before it is detached.
# Default 180000 (3 min). Chosen > client reconnect window and > the B-80a
# buffer retention (120s) so a returning tab re-registers a mirror first.
# CLAUDE_GHOST_DETACH_GRACE_MS=180000
#
# How often (ms) the lazy sweep scans active sessions. Default 30000 (30s).
# CLAUDE_GHOST_DETACH_SWEEP_MS=30000


# =============================================================================
# FULL ENVIRONMENT INVENTORY (audited 2026-07-26)
# =============================================================================
# Everything below was derived by sweeping the actual reads in the code
# (`process.env.X`, `process.env['X']` behind a constant, and `env.X` on an
# injected NodeJS.ProcessEnv) across server/, shared/ and scripts/ — not from
# memory. Format: one line per variable = default + what it changes.
#
# ⚠️  PLACEHOLDER VALUES ONLY. Never commit a real secret to this file. The
#     authoritative list of what counts as a secret is
#     server/services/isolation/sanitize-vendor-agent-env.js:
#       • exact host secrets  : JWT_SECRET, DATABASE_PATH,
#                               NASSAJ_PROVIDER_SECRETS_KEY,
#                               NASSAJ_FAKE_PROVIDER_KEY, OIDC_CLIENT_SECRET,
#                               BOOTSTRAP_OWNER_PASSWORD, SESSION_SECRET,
#                               COOKIE_SECRET, ENCRYPTION_KEY,
#                               INTERNAL_SHARED_SECRET, API_KEY
#       • suffixes            : *_SECRET, *_PASSWORD, …
#       • vendor namespaces   : ANTHROPIC_*, CLAUDE_*, OPENAI_*, GEMINI_*,
#                               CURSOR_*, GH_*, GITHUB_*, and any *_BASE_URL
#     Those names are stripped from EVERY provider subprocess at the single
#     resolveProviderEnv choke point — so setting them here affects the nassaj
#     host process only, never a spawned agent.

# -----------------------------------------------------------------------------
# CORE / TRANSPORT  (already described above; defaults restated for completeness)
# -----------------------------------------------------------------------------
# SERVER_PORT      default 3001. The port the code actually reads. PORT is the
#                  deprecated legacy alias, still honoured by vite.config.js only.
# HOST             default 0.0.0.0. Bind address for the API/WS server.
# VITE_PORT        default 5173. Dev-server port (vite only, not the API).
# ALLOWED_ORIGINS  unset ⇒ built-in CORS list. Comma-separated extra origins.
# DATABASE_PATH    unset ⇒ <repo>/database/auth.db. Absolute path of the live
#                  SQLite file. SECRET-CLASS: it is the users/hashes/keys store.
#                  Under a test runtime the connection REFUSES any path that is
#                  not under a temp root (see NASSAJ_ALLOW_NON_TEMP_TEST_DB).
# NODE_ENV         no default. 'test' additionally arms the test-DB isolation
#                  guard; 'production' makes npm prune devDependencies, which is
#                  why every install in this repo needs --include=dev.
# FS_CONCURRENCY   default 64. Max concurrent filesystem operations in the
#                  file-tree/search paths (server/index.js). Lower it on a node
#                  with a slow disk; 0/invalid falls back to the default.
# TMPDIR           OS default. Also counted as a trusted temp root by the
#                  test-database isolation guard.

# -----------------------------------------------------------------------------
# AUTH / IDENTITY
# -----------------------------------------------------------------------------
# JWT_SECRET       unset ⇒ a per-install secret is generated into app_config.
#                  SECRET. Single source of truth must be .env (never the PM2
#                  ecosystem env too — two disagreeing values rotate the secret
#                  on restart and log every existing token out).
# API_KEY          unset ⇒ the API-key middleware gate is DISABLED (no key is
#                  accepted). SECRET. When set, requests must match it exactly.
# AUTH_REFRESH_GRACE_HOURS  default 24. Hours a just-expired token may still be
#                  exchanged for a fresh one. Invalid/negative ⇒ warn + default.
# BOOTSTRAP_OWNER_USERNAME  default "owner". First-run owner account name.
# BOOTSTRAP_OWNER_PASSWORD  unset ⇒ a strong random password is generated and
#                  printed ONCE to the server log. SECRET.
# WEBAUTHN_RP_ID / WEBAUTHN_ORIGIN / WEBAUTHN_RP_NAME
#                  unset ⇒ localhost dev fallback (passkeys will not work on a
#                  deployed domain). See the AUTH section above.
# OIDC_ENABLED     default false. Every OIDC route returns 501 unless exactly
#                  'true'.
# OIDC_ISSUER_URL / OIDC_CLIENT_ID / OIDC_REDIRECT_URI  public RP settings.
# OIDC_CLIENT_SECRET  unset. SECRET — the relying-party secret. Placeholder only:
# OIDC_CLIENT_SECRET=replace-me-with-the-value-from-the-idp
# PLATFORM_MODE_UNAUTHENTICATED_ACK  unset ⇒ the fail-closed platform-mode boot
#                  guard stays armed. Deliberate operator acknowledgement only.
# VITE_IS_PLATFORM default unset. Exactly 'true' turns on platform mode, in
#                  which sessions are authenticated as the first user. Leaving
#                  it unset is the safe posture for a single-owner install.

# -----------------------------------------------------------------------------
# PROVIDER SECRETS STORE  (encryption at rest for per-user provider keys)
# -----------------------------------------------------------------------------
# NASSAJ_PROVIDER_SECRETS_KEY  unset ⇒ the store falls back to its non-env key
#                  source. SECRET, and the single highest-value one after
#                  JWT_SECRET: it decrypts EVERY user's stored provider API key.
#                  32-byte key, base64/hex encoded. Generate with:
#                    node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NASSAJ_PROVIDER_SECRETS_KEY=replace-me-32-byte-base64-key
# NASSAJ_FAKE_PROVIDER_KEY     unset. TEST-ONLY override of the same store.
#                  SECRET-class; must never be set on a real node.

# -----------------------------------------------------------------------------
# PROVIDER BINARIES / HOMES  (per-provider isolation knobs)
# -----------------------------------------------------------------------------
# CLAUDE_CLI_PATH     default 'claude' resolved through PATH.
# CLAUDE_CONFIG_DIR   per-user isolation root for the Claude CLI. Injected per
#                     spawn by resolve-provider-env; setting it globally here
#                     defeats per-user isolation — normally leave unset.
# AGY_PATH            default ~/.local/bin/agy.
# GEMINI_PATH         default 'gemini'.  GEMINI_CLI_HOME default $HOME.
# OPENCODE_PATH       unset ⇒ resolved via PATH. NOTE: the PM2 process does not
#                     read ~/.bashrc, so on a fleet node either set this or
#                     append ~/.opencode/bin to PATH in the ecosystem file.
# CODEX_HOME          per-user Codex config root (injected per spawn).
# KIMI_PATH           unset ⇒ resolved via PATH.  KIMI_CODE_HOME per-user root.
# KIMI_MAIN_AGENT_ID  unset ⇒ built-in default agent id for the Kimi synchronizer.
# XDG_CONFIG_HOME / XDG_DATA_HOME / XDG_CACHE_HOME / XDG_STATE_HOME
#                     OS defaults. Used to isolate carrier providers (opencode).
# WORKSPACES_ROOT     default $HOME. Root under which project workspaces live.
# NASSAJ_RUNNER_ROOT  default ~/.local/share/nassaj-dev/runner (runner bridge).

# -----------------------------------------------------------------------------
# HOSTED-VENDOR API KEYS  (all SECRET, all optional; unset ⇒ fall back to the
# per-user encrypted store. Placeholders only.)
# -----------------------------------------------------------------------------
# GEMINI_API_KEY=replace-me
# GOOGLE_API_KEY=replace-me
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# GOOGLE_CLOUD_PROJECT=my-gcp-project
# GOOGLE_CLOUD_PROJECT_ID=my-gcp-project
# GOOGLE_CLOUD_LOCATION=us-central1
# KIMI_API_KEY=replace-me
# DEEPSEEK_API_KEY=replace-me
# GLM_API_KEY=replace-me
# ANTHROPIC_API_KEY / ANTHROPIC_AUTH_TOKEN / CLAUDE_CODE_OAUTH_TOKEN
#   Read by the Claude path. Never set them for a vendor turn — they are
#   denylisted out of every non-Claude spawn on purpose (IRON RULE).

# -----------------------------------------------------------------------------
# CODEX SANDBOX POSTURE  (ADR-058 — both default to the SAFE value)
# -----------------------------------------------------------------------------
# CODEX_ALLOW_FULL_ACCESS   unset/anything but 'true' ⇒ Codex is capped at
#                  workspace-write. Exactly 'true' lifts the cap to full access.
#                  Treat as a production-risk switch: it removes the sandbox
#                  ceiling for every Codex turn on the node.
# CODEX_WORKSPACE_NETWORK   unset ⇒ network OFF inside the Codex workspace
#                  sandbox. Exactly 'true' enables it.

# -----------------------------------------------------------------------------
# PROVIDER CAGE  (secret-hiding jail for provider subprocesses)
# -----------------------------------------------------------------------------
# NASSAJ_PROVIDER_CAGE  unset ⇒ OFF (byte-for-byte previous behaviour). Exactly
#                  'true' turns the cage on: provider credentials, gh tokens and
#                  the live db.sqlite are hidden from the spawned provider.
#                  Ships OFF pending the owner's allowlist decision.

# -----------------------------------------------------------------------------
# OPENCODE CARRIER
# -----------------------------------------------------------------------------
# NASSAJ_OPENCODE_CARRIER  unset ⇒ carrier mode OFF. Gates routing a governed
#                  vendor model through the OpenCode carrier.

# -----------------------------------------------------------------------------
# SESSION REGISTRY  (per-provider, ADR-041)
# -----------------------------------------------------------------------------
# SESSION_REGISTRY_<provider>  unset ⇒ OFF. Accepts 1/true/yes/on. One flag per
#                  provider; the registry it gates is read-only replay/buffer,
#                  so turning a flag off is a complete no-op with no data loss.
#                  Live on the alkindy node: SESSION_REGISTRY_claude=1.
# SESSION_REGISTRY_claude=1
# SESSION_REGISTRY_agy=1

# -----------------------------------------------------------------------------
# CLAUDE RUNTIME TIMEOUTS
# -----------------------------------------------------------------------------
# CLAUDE_TOOL_APPROVAL_TIMEOUT_MS         default 55000 (55s).
# CLAUDE_INTERACTIVE_APPROVAL_TIMEOUT_MS  default 1800000 (30 min) — the window
#                  an interactive tool-approval prompt waits for a human.
# CLAUDE_CODE_STREAM_CLOSE_TIMEOUT        set to '300000' by the code around the
#                  SDK call and restored afterwards; an inherited value is
#                  overridden, so setting it here has no lasting effect.
# CONTEXT_WINDOW   unset ⇒ inferred from the model (opus / sonnet 4.6+ = 1M).
#                  A positive integer forces an override for every model.
# COMMANDS_COLD_PROBE_WAIT_MS  default 1000. Cold-probe wait for the slash-command
#                  discovery pass.
# DEBUG_CLAUDE_AGENT_SDK  unset ⇒ OFF. 1/true/yes/on makes the agent SDK write
#                  sdk-<id>.txt under <CLAUDE_CONFIG_DIR>/debug/. Diagnostic only.

# -----------------------------------------------------------------------------
# ULTRACODE
# -----------------------------------------------------------------------------
# ENABLE_ULTRACODE_WORKFLOWS  unset ⇒ OFF. Exactly 'true' or '1' injects the
#                  ultracode env into workflow spawns.

# -----------------------------------------------------------------------------
# SHUTDOWN DRAIN / BIND GUARD  (B-N-DRAIN; also set in the PM2 ecosystem file)
# -----------------------------------------------------------------------------
# DRAIN_TIMEOUT_MS         default unset ⇒ bounded drain. '0' = NO deadline
#                  (the fleet setting: a role may run for hours). Must stay
#                  consistent with PM2 kill_timeout.
# LISTEN_BIND_WINDOW_MS    fleet setting '10000'. How long a starting instance
#                  tolerates EADDRINUSE from a draining predecessor before
#                  exiting cleanly instead of crash-looping.
# CLAUDE_GHOST_DETACH / _GRACE_MS / _SWEEP_MS  see the dedicated section above.

# -----------------------------------------------------------------------------
# WORKFLOW SUPERVISOR  (B-103; phase 1 live, phase 2 chat-lock still OFF)
# -----------------------------------------------------------------------------
# WORKFLOW_SUPERVISOR              unset ⇒ OFF. '1' enables the durable runner.
# WORKFLOW_SUPERVISOR_CHAT_LOCK    unset ⇒ OFF (phase 2, pending soak + sign-off).
# WORKFLOW_SUPERVISOR_CHAT_LOCK_WAIT_MS  default = injector max-hold + 5000.
# WORKFLOW_SUPERVISOR_POLL_MS      default 2000. Supervisor loop interval.
# WORKFLOW_SUPERVISOR_CLAUDE_BIN   default 'claude'.
# WORKFLOW_SUPERVISOR_STATE_DIR    default ~/.local/share/nassaj-dev/workflow-supervisor
# WORKFLOW_SUPERVISOR_MAX_PER_USER default 3.  Concurrent scopes per user.
# WORKFLOW_SUPERVISOR_MAX_GLOBAL   default 8.  Host-wide concurrent scope cap
#                  (the second gate against the 2026-06-06 OOM class).
# WORKFLOW_SUPERVISOR_MAX_PENDING_PER_USER default 50. Queued-intent cap.
# WORKFLOW_SUPERVISOR_INTENT_TTL_MS        default 86400000 (24h).
# WORKFLOW_SUPERVISOR_QUEUE_BACKOFF_MS     default 30000.
# WORKFLOW_SUPERVISOR_SWEEP_INTERVAL_MS    default 300000 (5 min).
# WORKFLOW_SUPERVISOR_RECONCILE_GRACE_MS   default 10000.
# WORKFLOW_SUPERVISOR_HANDOFF_MAX_HOLD_MS  default 90000. Hard cap on how long
#                  the injector may hold the per-conversation lock.
# WORKFLOW_SUPERVISOR_HANDOFF_WIDEN_MS     default 0.
# WORKFLOW_SUPERVISOR_INJECT_WIDEN_MS      default 0.
# WORKFLOW_SUPERVISOR_HANDOFF_MODEL        unset ⇒ CLI default model.
# WORKFLOW_SUPERVISOR_HANDOFF_KILL         unset ⇒ OFF.
# WORKFLOW_SUPERVISOR_HANDOFF_TOKENS_CONV_MAX     default 300000.
# WORKFLOW_SUPERVISOR_HANDOFF_TOKENS_USER_MAX     default 1000000.
# WORKFLOW_SUPERVISOR_HANDOFF_TURN_TOKEN_ESTIMATE default 73000.

# -----------------------------------------------------------------------------
# WORKFLOW RECONCILE  (ADR-048)
# -----------------------------------------------------------------------------
# WORKFLOW_RECONCILE           unset ⇒ OFF. '1' enables the read-only
#                  stopped→completed correction derived from the transcript.
# WORKFLOW_RECONCILE_QUIET_MS  default 5000. Quiet window before a run is
#                  considered settled.

# -----------------------------------------------------------------------------
# COORDINATOR GUARD  (ADR-064)
# -----------------------------------------------------------------------------
# NASSAJ_COORDINATOR  unset ⇒ instant no-op. Exactly '1' enables informational
#                  ground-truth injection on delegation. Purely additive
#                  context; it never blocks or denies a tool call.

# -----------------------------------------------------------------------------
# PENDING SERVER ACTIONS
# -----------------------------------------------------------------------------
# NASSAJ_PENDING_ACTIONS_RETENTION  unset ⇒ retention sweep disabled. '1' enables
#                  pruning of the pending-server-actions table.

# -----------------------------------------------------------------------------
# TEST-ONLY ESCAPE HATCHES  (never set these on a real node)
# -----------------------------------------------------------------------------
# NASSAJ_ALLOW_NON_TEMP_TEST_DB  unset ⇒ the guard stands. '1' lets a test run
#                  open a database outside a temp directory — i.e. potentially
#                  the LIVE one. Deliberate override only.
# NODE_TEST_CONTEXT / VITEST  set by the node:test and vitest runners themselves;
#                  the DB isolation guard keys off them. Never set by hand.

# -----------------------------------------------------------------------------
# READ BUT NOT OWNED BY THIS APP
# -----------------------------------------------------------------------------
# PATH, HOME, USERPROFILE, LANG, TERM, COLORTERM, FORCE_COLOR — standard process
# env, forwarded to provider CLIs. GITHUB_TOKEN and GIT_CONFIG_* are consumed by
# the git integration (GITHUB_TOKEN is denylisted out of vendor spawns).
# pm_pid_path is injected by PM2 and read by the drain orphan-detection logic.
# WF_BASE / PROC_NAME / SERVER_PID / SESSION_JSON / FRESH_WINDOW_S / SR_* are
# internal to scripts/safe-restart.sh and scripts/memory-guard.sh, not app config.

# -----------------------------------------------------------------------------
# Deployment-specific behaviour that used to be hardcoded (2026-07-29)
# -----------------------------------------------------------------------------
# Response language pinned for the antigravity (agy) provider. agy answers in
# English by default and ignores the UI locale. Leave UNSET for no language rule.
# NASSAJ_RESPONSE_LANGUAGE=formal Arabic (العربية الفصحى)

# Repository the coordinator ground-truth layer reads commits/tasks from when a
# caller passes no explicit root. Defaults to the server's working directory.
# NASSAJ_COORDINATOR_REPO_ROOT=/path/to/your/repo
